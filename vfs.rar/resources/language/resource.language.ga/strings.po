msgctxt "#30000"
msgid "RAR file extract"
msgstr "Sliocht comhaid RAR"

msgctxt "#30001"
msgid "RAR file scan"
msgstr "Scanadh comhad RAR"

msgctxt "#30002"
msgid "RAR solid file scan"
msgstr "Scanadh comhad soladach RAR"

msgctxt "#30003"
msgid "Enter RAR package password for:\n%s"
msgstr ""
"Cuir isteach focal faire an phacáiste RAR le haghaidh:\n"
"%s"

msgctxt "#30004"
msgid "Not enough disk space available"
msgstr "Níl dóthain spáis diosca ar fáil"

# Following strings used for addon settings dialog
msgctxt "#30010"
msgid "General"
msgstr "Ginearálta"

msgctxt "#30011"
msgid "Ask for password"
msgstr "Iarr pasfhocal"

msgctxt "#30012"
msgid "If archives are password protected, prompt for the password to be entered"
msgstr "Má tá na cartlanna faoi chosaint pasfhocail, iarr an pasfhocal a iontráil"

msgctxt "#30013"
msgid "Pre-defined password to attempt decompression with"
msgstr "Pasfhocal réamhshainithe chun iarracht a dhéanamh dí-chomhbhrú leis"

msgctxt "#30014"
msgid "Stored password 1"
msgstr "Pasfhocal stóráilte 1"

msgctxt "#30015"
msgid "Stored password 2"
msgstr "Pasfhocal stóráilte 2"

msgctxt "#30016"
msgid "Stored password 3"
msgstr "Pasfhocal stóráilte 3"

msgctxt "#30017"
msgid "Stored password 4"
msgstr "Pasfhocal stóráilte 4"

msgctxt "#30018"
msgid "Stored password 5"
msgstr "Pasfhocal stóráilte 5"

msgctxt "#30019"
msgid "Confirm copy"
msgstr "Deimhnigh cóip"

msgctxt "#30020"
msgid "Need to unpack a big file. Continue?"
msgstr "An gá duit comhad mór a dhíphacáil. Lean ar aghaidh?"

msgctxt "#30021"
msgid "Not enough memory available to decompress file"
msgstr "Níl dóthain cuimhne ar fáil chun an comhad a dhí-chomhbhrú"

msgctxt "#30022"
