msgstr "Pasfhocail"

msgctxt "#30023"
msgid "Asks to unpack"
msgstr "Iarrann sé díphacáil"

msgctxt "#30024"
msgid "Asks you with a dialog to confirm the unpacking of a larger file."
msgstr "Iarrann sé ort le dialóg díphacáil comhaid níos mó a dhearbhú."

msgctxt "#30025"
msgid "Unpack compressed"
msgstr "Díphacáil comhbhrúite"

msgctxt "#30026"
msgid "Disable to avoid unpacking compressed rar archives."
msgstr "Díchumasaigh chun díphacáil cartlanna rar comhbhrúite a sheachaint."
